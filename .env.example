# Copy to .env (or run `make env`, which fills in random secrets).

# --- secrets (required) ---
MONGO_ROOT_PASSWORD=change-me
MONGO_APP_PASSWORD=change-me
SESSION_SECRET=change-me
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- what we track: a profile in config/domains/ (legal-partners, football, ...) ---
RADAR_DOMAIN=legal-partners

# --- AI via OpenRouter (optional: empty key = the app runs without AI features) ---
OPENROUTER_API_KEY=
LLM_MODEL_BRIEF=nvidia/nemotron-3.5-super-vl:free
LLM_MODEL_CHEAP=google/gemma-4-31b-it:free
LLM_FALLBACK_MODELS=google/gemma-4-31b-it:free
LLM_DAILY_BUDGET_USD=1.00
# true = only route to providers that neither store nor train on prompts (excludes many free models)
LLM_DENY_DATA_COLLECTION=false

# --- crawler etiquette ---
# Crawling stays OFF until this names YOU (an email or URL the organisations can reach). The placeholder
# below is refused on purpose, so a copy of the demo never hits the organisations' sites by accident.
SCRAPER_USER_AGENT="PartnerRadarBot/0.1 (+mailto:change-me@example.com)"
SCRAPER_MIN_DELAY_S=3
# Never fetch localhost or private networks. Set true only to crawl a test site on your own machine/LAN.
SCRAPER_ALLOW_PRIVATE_HOSTS=false
WORKER_LANES=4

# --- web ---
WEB_PORT=8080
# A domain (e.g. radar.example.com) makes Caddy fetch a TLS certificate; ":80" = plain HTTP.
SITE_ADDRESS=:80
SESSION_HTTPS_ONLY=false
CORS_ORIGINS=http://localhost:5173
